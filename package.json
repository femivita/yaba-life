{
  "name": "yaba-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Nigerian life simulation for the web, starting in Yaba, Lagos.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:fetch": "python3 tools/fetch_overture.py",
    "data:build": "python3 tools/build_map.py",
    "character:build": "python3 tools/character/build_character.py"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/three": "^0.180.0",
    "typescript": "5.9",
    "vite": "^7.3.7"
  }
}
